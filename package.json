{
  "name": "tabby-paneworks",
  "version": "0.3.0",
  "description": "Workspaces for Tabby: predefined split layouts with startup commands; panes show their program title, the tab shows the workspace name (fork of TabbySpaces)",
  "keywords": [
    "tabby",
    "tabby-plugin"
  ],
  "main": "dist/index.js",
  "type": "commonjs",
  "typings": "dist/index.d.ts",
  "scripts": {
    "build": "node scripts/build-prod.js",
    "build:dev": "node scripts/build-dev.js",
    "watch": "webpack --mode development --watch",
    "watch:dev": "webpack --mode development --watch --env dev --output-path dist-dev"
  },
  "peerDependencies": {
    "@angular/common": "^15.0.0",
    "@angular/core": "^15.0.0",
    "@angular/forms": "^15.0.0",
    "tabby-core": "*",
    "tabby-local": "*",
    "tabby-settings": "*",
    "tabby-terminal": "*"
  },
  "devDependencies": {
    "@angular/common": "^15.0.0",
    "@angular/compiler": "^15.0.0",
    "@angular/compiler-cli": "^15.0.0",
    "@angular/core": "^15.0.0",
    "@angular/forms": "^15.0.0",
    "@ng-bootstrap/ng-bootstrap": "^14.2.0",
    "@ngtools/webpack": "^15.0.0",
    "@types/node": "^18.15.13",
    "apply-loader": "^2.0.0",
    "css-loader": "^6.8.0",
    "pug": "^3.0.2",
    "pug-loader": "^2.4.0",
    "raw-loader": "^4.0.2",
    "rxjs": "^7.8.0",
    "sass": "^1.63.0",
    "sass-loader": "^13.3.0",
    "tabby-core": "^1.0.197-nightly.1",
    "tabby-local": "^1.0.197-nightly.1",
    "tabby-settings": "^1.0.197-nightly.1",
    "tabby-terminal": "^1.0.197-nightly.1",
    "to-string-loader": "^1.2.0",
    "ts-loader": "^9.5.4",
    "typescript": "~4.9.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "zone.js": "^0.13.0"
  },
  "author": "Patrick Schaefer (fork of TabbySpaces by Igor Halilovic)",
  "license": "MIT",
  "tabbyPlugin": {
    "name": "paneworks",
    "displayName": "Paneworks",
    "description": "Workspaces for Tabby: predefined split layouts with startup commands; panes show their program title, the tab shows the workspace name (fork of TabbySpaces)"
  },
  "private": true
}
